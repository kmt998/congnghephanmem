# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN QUẢN LÝ CHUỖI DỊCH VỤ THỂ DỤC THỂ THAO (10 CƠ SỞ)
# Hướng dẫn: Copy file này thành .env và chỉnh sửa nếu cần:
#   Windows CMD/PowerShell: copy .env.example .env
#   Linux/macOS:            cp .env.example .env
# ==============================================================================

# ── 1. KẾT NỐI DATABASE SQL SERVER ──────────────────────────────────────────
# Nếu dùng Docker compose đi kèm repo:
DB_SERVER=localhost,1433
DB_NAME=TrungTamTheThao
DB_USER=sa
DB_PASSWORD=SportChain@2026
DB_DRIVER=ODBC Driver 17 for SQL Server

# Nếu dùng SQL Server cục bộ trên Windows (SSMS):
# DB_SERVER=localhost\SQLEXPRESS
# DB_NAME=TrungTamTheThao
# DB_USER=
# DB_PASSWORD=
# DB_DRIVER=ODBC Driver 17 for SQL Server

# ── 2. XÁC THỰC JWT & FLASK SESSION ─────────────────────────────────────────
JWT_SECRET=sportchain-jwt-secret-2026-trungtamthethao
SECRET_KEY=sportchain-secret-key-2026-nhom-cnpm

# ── 3. CẤU HÌNH FLASK ───────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_DEBUG=1
